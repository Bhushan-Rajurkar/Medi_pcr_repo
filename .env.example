# ==============================================================================
# MEDI-PCR Backend Environment Variables Template (.env.example)
# Copy this file to .env and fill in your confidential credentials.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/api/v1.1
APP_BASE_URL=http://localhost:8080

# Database Credentials (PostgreSQL - Local)
DB_URL=jdbc:postgresql://localhost:5432/medi_pcr_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Production Database Credentials (for application-prod.properties)
SERVER_DB_URL=jdbc:postgresql://your-remote-host:5432/medi_pcr_db
SERVER_DB_USER_NAME=your_prod_db_username
SERVER_DB_PASS=your_prod_db_password

# Active Spring Profile (uncomment to activate prod profile)
# SPRING_PROFILES_ACTIVE=prod

# JWT Authentication Secret
JWT_SECRET=your_base64_or_hex_encoded_256_bit_jwt_secret_key
JWT_EXPIRATION_MS=86400000

# Brevo (Sendinblue) SMTP Email Configuration
BREVO_USERNAME=your_brevo_smtp_login
BREVO_PASS=your_brevo_smtp_key_or_password
BREVO_from_email=your_verified_sender@domain.com

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Admin Service Account Config Path
FIREBASE_CONFIG_PATH=classpath:my-medi-pcr-firebase-adminsdk-fbsvc-d963a4e80a.json
